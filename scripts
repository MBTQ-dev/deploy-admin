Phase 4: API Integration (Week 11-12)
4.1 API Client (Shared)
// frontend/src/api/client.ts
const API_BASE = 'http://api.mbtq.local';
class MBTQClient {
private token: string | null = null;
setToken(token: string) {
this.token = token;
localStorage.setItem('mbtq_token', token);
}
async request(endpoint: string, options: RequestInit = {}) {
const headers: HeadersInit = {
'Content-Type': 'application/json',
...(this.token && { Authorization: `Bearer ${this.token}` }),
...options.headers,
};
const response = await fetch(`${API_BASE}${endpoint}`, {
...options,
headers,
});
if (!response.ok) {
throw new Error(`API Error: ${response.statusText}`);
}
return response.json();
}
// Auth endpoints
async login(email: string, password: string) {
const data = await this.request('/auth/login', {
method: 'POST',
body: JSON.stringify({ email, password }),
});
this.setToken(data.access_token);
return data;
}
async register(email: string, password: string, name: string) {
return this.request('/auth/register', {
method: 'POST',
body: JSON.stringify({ email, password, name }),
});
}
// Workflow endpoints
async triggerWorkflow(repo: string, action: string) {
return this.request('/workflows/trigger', {
method: 'POST',
body: JSON.stringify({ repo, action }),
});
// Reputation endpoints
async getReputation(userId: string) {
return this.request(`/reputation/${userId}`);
}
}
// AI endpoints
async processVideo(file: File) {
const formData = new FormData();
formData.append('video', file);
return this.request('/ai/process-video', {
method: 'POST',
body: formData,
headers: {}, // Let browser set Content-Type
});
}
}
export const api = new MBTQClient();
4.2 NGINX API Gateway (Local)
# infrastructure/nginx/sites/api-gateway.conf
# API Gateway - routes to all backends
server {
listen 80;
server_name api.mbtq.local;
# DeafAUTH - Identity
location /auth/ {
proxy_pass http://localhost:4001/;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
}
# PinkSync - Workflows
location /workflows/ {
proxy_pass http://localhost:4002/;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# WebSocket support
proxy_http_version 1.1;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection "upgrade";
}
# Fibonrose - Reputation
location /reputation/ {
proxy_pass http://localhost:4003/;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
}
# Magicians - AI
location /ai/ {
proxy_pass http://localhost:4004/;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# Longer timeout for AI processing
proxy_read_timeout 600s;
}
# Content - Media
location /media/ {
proxy_pass http://localhost:4005/;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# Large file uploads
client_max_body_size 500M;
}
}
# Frontend
server {
listen 80;
server_name mbtq.local;
location / {
proxy_pass http://localhost:3000;
proxy_set_header Host $host;
}
}
# Mission Control
server {
listen 80;
server_name control.mbtq.local;
location / {
proxy_pass http://localhost:8000;
proxy_set_header Host $host;
}
}
